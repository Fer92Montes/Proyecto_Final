# Copia este archivo como .env y sustituye los marcadores por claves de prueba.
# Clave secreta usada por el servidor para crear y consultar sesiones de Stripe Checkout.
STRIPE_SECRET_KEY=sk_test_pon_aqui_tu_clave_secreta
# Firma que Stripe CLI usa para autenticar webhooks dirigidos a la aplicación local.
STRIPE_WEBHOOK_SECRET=whsec_pon_aqui_el_secreto_de_stripe_listen
# Código de moneda ISO que se envía al proveedor para formar los importes del pago.
STRIPE_CURRENCY=eur